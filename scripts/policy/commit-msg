#!/bin/sh

# Installed as .git/hooks/commit-msg. Keep this small so Git invokes the same
# entry point on Windows (Git for Windows), macOS, and Linux.
set -u

repository_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "policy hook: cannot locate the repository root" >&2
    exit 1
}
hook_dir=$(git config --path --get core.hooksPath 2>/dev/null || git rev-parse --git-path hooks 2>/dev/null) || exit 1
case "$hook_dir" in
    /*|[A-Za-z]:/*) ;;
    *) hook_dir=$repository_root/$hook_dir ;;
esac
hook_command=$hook_dir/commit-msg.policy-original
if [ -f "$hook_command" ] && [ -x "$hook_command" ]; then
    "$hook_command" "$1"
    original_status=$?
    if [ "$original_status" -ne 0 ]; then
        exit "$original_status"
    fi
fi

if command -v python3 >/dev/null 2>&1 && \
        python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    python_command=python3
elif command -v python >/dev/null 2>&1 && \
        python -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
    python_command=python
else
    echo "policy hook: Python 3.10 or newer is required on PATH" >&2
    exit 1
fi
exec "$python_command" -B "$repository_root/scripts/policy/hooks.py" commit-msg "$1"
