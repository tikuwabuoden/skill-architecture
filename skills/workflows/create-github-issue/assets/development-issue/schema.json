{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development issue input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "background",
    "goal",
    "acceptanceCriteria",
    "scope",
    "outOfScope",
    "verification",
    "dependencies",
    "risks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
    },
    "background": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
      }
    },
    "outOfScope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])(?!(?:.*```))(?=.*\\S).+$"
      }
    }
  }
}
